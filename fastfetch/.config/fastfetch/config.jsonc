{

"$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

"logo": {

"source": "~/.config/fastfetch/luffy.png",

"type": "kitty",

"height": 16,

"padding": {

"top": 5

}

},

"display": {

"separator": " "

},

"modules": [

{

"key": "╭───────────╮",

"type": "custom"

},

{

"key": "│ {#31} user {#keys}│",

"type": "title",

"format": "{user-name}"

},

{

"key": "│ {#32}󰇅 hname {#keys}│",

"type": "title",

"format": "{host-name}"

},

{

"key": "│ {#35}󰇅 host {#keys}│",

"type": "host",

},

{

"key": "│ {#34}󰅐 uptime {#keys}│",

"type": "uptime"

},

{

"key": "├───────────┤",

"type": "custom"

},

{

"key": "│ {#36}󰣇 distro {#keys}│",

"type": "os"

},

{

"key": "│ {#32} kernel {#keys}│",

"type": "kernel"

},

{

"key": "│ {#35} bootmgr {#keys}│",

"type": "bootmgr",

"format": "{name}"

},

{

"key": "│ {#34} init {#keys}│",

"type": "initsystem",

"format": "{name}"

},

{

"type": "command",

"key": "│ {#33} OS Age {#keys}│",

"text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"

},

{

"type": "packages",

"key": "│ {#31}{icon} pkgs {#keys}│",

},

{

"key": "├───────────┤",

"type": "custom"

},

{

"key": "│ {#34} desktop {#keys}│",

"type": "de"

},

{

"key": "│ {#36} wm {#keys}│",

"type": "wm"

},

{

"key": "│ {#33} lm {#keys}│",

"type": "lm"

},

{

"key": "├───────────┤",

"type": "custom"

},

{

"key": "│ {#34} term {#keys}│",

"type": "terminal"

},

{

"key": "│ {#32} shell {#keys}│",

"type": "shell"

},

{

"key": "├───────────┤",

"type": "custom"

},

{

"key": "│ {#33}󰍛 cpu {#keys}│",

"type": "cpu",

"showPeCoreCount": true

},

{

"key": "│ {#31}󰍛 gpu {#keys}│",

"type": "gpu",

"showPeCoreCount": true

},

{

"key": "│ {#35}󰇄 monitor {#keys}│",

"type": "display"

},

{

"key": "│ {#36} memory {#keys}│",

"type": "memory"

},

{

"key": "│ {#34}󰉉 root {#keys}│",

"type": "disk",

"folders": "/"

},

{

"key": "│ {#32} home {#keys}│",

"type": "disk",

"folders": "/home"

},

{

"key": "╰───────────╯",

"type": "custom"

}

]

}
